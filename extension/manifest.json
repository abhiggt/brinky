{
  "manifest_version": 3,
  "name": "Brinky: Blink & Drink",
  "short_name": "Brinky",
  "version": "0.0.1",
  "description": "A calm water-drop friend for your eyes and your water: gentle eye exercises, blink nudges and water reminders.",
  "minimum_chrome_version": "130",
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Brinky",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png",
      "48": "icons/48.png",
      "128": "icons/128.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": [
    "storage",
    "alarms",
    "idle",
    "notifications",
    "scripting",
    "contextMenus"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "pointer.js"
      ],
      "run_at": "document_start"
    }
  ],
  "commands": {
    "eye-now": {
      "suggested_key": {
        "default": "Alt+Shift+B"
      },
      "description": "Take an eye break now"
    },
    "log-water": {
      "suggested_key": {
        "default": "Alt+Shift+W"
      },
      "description": "Log a glass of water"
    },
    "toggle-pause": {
      "suggested_key": {
        "default": "Alt+Shift+P"
      },
      "description": "Pause or resume Brinky for an hour"
    }
  },
  "web_accessible_resources": [
    {
      "resources": [
        "mascot/*.webp",
        "fonts/*.woff2"
      ],
      "matches": [
        "<all_urls>"
      ],
      "use_dynamic_url": true
    }
  ],
  "options_ui": {
    "page": "settings.html",
    "open_in_tab": true
  }
}